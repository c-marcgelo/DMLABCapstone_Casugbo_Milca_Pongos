		<properties node_id="40" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x80\x00\x00\x00\x80\x00\x00\x03\xa1\x00\x00\x02\xde\x00\x00\x00\x81\x00\x00\x00\x9e\x00\x00\x03\xa0\x00\x00\x02\xdd\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x00\x81\x00\x00\x00\x9e\x00\x00\x03\xa0\x00\x00\x02\xdd', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': '\nimport numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable\n\n# Select the variable to analyze\ncolumn_name = "withdrawal_mcm"\n\n# Get the selected column\nvariable = in_data.domain[column_name]\nvalues = in_data.get_column(variable).astype(float)\n\n# Exclude missing values when calculating quartiles\nvalid = np.isfinite(values)\nclean_values = values[valid]\n\n# Calculate IQR boundaries\nq1 = np.percentile(clean_values, 25)\nq3 = np.percentile(clean_values, 75)\niqr = q3 - q1\n\nlower_bound = q1 - (1.5 * iqr)\nupper_bound = q3 + (1.5 * iqr)\n\n# Identify potential anomalies\nis_anomaly = valid &amp; (\n    (values &lt; lower_bound) | (values &gt; upper_bound)\n)\n\n# Get the year column\nyear_variable = in_data.domain["year"]\nyears = in_data.get_column(year_variable).astype(float)\n\n# Create results table\ndomain = Domain([\n    ContinuousVariable("Year"),\n    ContinuousVariable("Withdrawal (MCM)"),\n    ContinuousVariable("Q1"),\n    ContinuousVariable("Q3"),\n    ContinuousVariable("IQR"),\n    ContinuousVariable("Lower Bound"),\n    ContinuousVariable("Upper Bound"),\n    ContinuousVariable("Anomaly (1=Yes)")\n])\n\nresults = np.column_stack([\n    years,\n    values,\n    np.full(len(values), q1),\n    np.full(len(values), q3),\n    np.full(len(values), iqr),\n    np.full(len(values), lower_bound),\n    np.full(len(values), upper_bound),\n    is_anomaly.astype(float)\n])\n\nout_data = Table.from_numpy(domain, results)\n\nprint("Industrial Water Withdrawal - IQR Results")\nprint("Q1:", q1)\nprint("Q3:", q3)\nprint("IQR:", iqr)\nprint("Lower Bound:", lower_bound)\nprint("Upper Bound:", upper_bound)\nprint("Potential anomalies:", int(is_anomaly.sum()))\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="41" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00a\x00\x00\x00\xc0\x00\x00\x03\x82\x00\x00\x03\x1e\x00\x00\x00b\x00\x00\x00\xde\x00\x00\x03\x81\x00\x00\x03\x1d\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x00b\x00\x00\x00\xde\x00\x00\x03\x81\x00\x00\x03\x1d', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': '\nimport numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable\n\n# Select the variable to analyze\ncolumn_name = "wue_industry"\n\n# Get the selected column\nvariable = in_data.domain[column_name]\nvalues = in_data.get_column(variable).astype(float)\n\n# Exclude missing values when calculating quartiles\nvalid = np.isfinite(values)\nclean_values = values[valid]\n\n# Calculate IQR boundaries\nq1 = np.percentile(clean_values, 25)\nq3 = np.percentile(clean_values, 75)\niqr = q3 - q1\n\nlower_bound = q1 - (1.5 * iqr)\nupper_bound = q3 + (1.5 * iqr)\n\n# Identify potential anomalies\nis_anomaly = valid &amp; (\n    (values &lt; lower_bound) | (values &gt; upper_bound)\n)\n\n# Get the year column\nyear_variable = in_data.domain["year"]\nyears = in_data.get_column(year_variable).astype(float)\n\n# Create results table\ndomain = Domain([\n    ContinuousVariable("Year"),\n    ContinuousVariable("Withdrawal (MCM)"),\n    ContinuousVariable("Q1"),\n    ContinuousVariable("Q3"),\n    ContinuousVariable("IQR"),\n    ContinuousVariable("Lower Bound"),\n    ContinuousVariable("Upper Bound"),\n    ContinuousVariable("Anomaly (1=Yes)")\n])\n\nresults = np.column_stack([\n    years,\n    values,\n    np.full(len(values), q1),\n    np.full(len(values), q3),\n    np.full(len(values), iqr),\n    np.full(len(values), lower_bound),\n    np.full(len(values), upper_bound),\n    is_anomaly.astype(float)\n])\n\nout_data = Table.from_numpy(domain, results)\n\nprint("Industrial Water Withdrawal - IQR Results")\nprint("Q1:", q1)\nprint("Q3:", q3)\nprint("IQR:", iqr)\nprint("Lower Bound:", lower_bound)\nprint("Upper Bound:", upper_bound)\nprint("Potential anomalies:", int(is_anomaly.sum()))\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
